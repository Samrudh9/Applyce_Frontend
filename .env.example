# ──────────────────────────────────────────────
# Applyce Frontend – Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local for local overrides (never commit secrets).

# Backend API base URL.
# Production (Vercel):  set VITE_API_URL=https://skillfit.onrender.com
#                       in your Vercel project's Environment Variables settings.
# Local development:    leave VITE_API_URL unset (or comment it out below).
#                       The Vite dev-server proxy will forward /api/* requests
#                       to http://localhost:5000 automatically.
# VITE_API_URL=https://skillfit.onrender.com
